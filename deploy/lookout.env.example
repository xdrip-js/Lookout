# /etc/lookout.env (root:root, mode 600): read by lookout.service.
NIGHTSCOUT_HOST=https://YOUR-NIGHTSCOUT.example.com
API_SECRET=your-nightscout-api-secret
# Dexcom G7 on the WATCH slot (3). Never use --force_medical_slot: slot 1 is
# the pump's (e.g. Omnipod 5). --sensor_address pins Lookout to one sensor so
# it never tries to pair with someone else's; deploy/g7-new-sensor.sh sets it.
LOOKOUT_ARGS=--openaps /home/pi/myopenaps --display_type watch --sensor_address AA:BB:CC:DD:EE:FF --no_xdripaps
